# Settings for ioc-analyzer. Copy this file to:
#   Windows:      %APPDATA%\ioc-analyzer\.env
#   Linux/macOS:  ~/.config/ioc-analyzer/.env
# Real environment variables override these values.
# A .env in your current folder is NOT read (see README).
VIRUSTOTAL_API=
ABUSEIPDB_API=
VIRUSTOTAL_RATE_PER_MIN=4